# SPI Flash
# Testpoints
# Constraints

# Period Constraints
FREQUENCY PORT "clk" 50.0 MHz;
FREQUENCY NET "auxclks[0]" 330.0 MHz;
FREQUENCY NET "auxclks[1]" 66.0 MHz;
FREQUENCY NET "auxclks[2]" 60.0 MHz;
FREQUENCY NET "clk_28m" 28.6 MHz;
FREQUENCY NET "clk_sys" 114.3 MHz;
FREQUENCY NET "clk_142m" 142.9 MHz;

# Select changes occur during video reset; exclude select-to-clock propagation.
BLOCK COMP "clkmux_0" PIN "SEL0" ;
BLOCK COMP "clkmux_0" PIN "SEL1" ;
BLOCK COMP "clkmux_1" PIN "SEL0" ;
BLOCK COMP "clkmux_1" PIN "SEL1" ;

# Explicit constraints on the DCSC output clocks.
FREQUENCY NET "clk_pixel" 66.0 MHz;
FREQUENCY NET "clk_tmds" 330.0 MHz;

# Used to avoid timing failures for HDMI clock switch as we use clk to switch DCSC
BLOCK PATH FROM CLKNET "clk_c" TO CLKNET "clk_sys";
BLOCK PATH FROM CLKNET "clk_c" TO CLKNET "auxclks[0]";
BLOCK PATH FROM CLKNET "clk_c" TO CLKNET "auxclks[1]";
BLOCK PATH FROM CLKNET "clk_c" TO CLKNET "clk_pixel";
BLOCK PATH FROM CLKNET "clk_c" TO CLKNET "clk_tmds";
BLOCK PATH FROM CLKNET "clk_sys" TO CLKNET "clk_c";
BLOCK PATH FROM CLKNET "auxclks[0]" TO CLKNET "clk_c";
BLOCK PATH FROM CLKNET "auxclks[1]" TO CLKNET "clk_c";
BLOCK PATH FROM CLKNET "clk_pixel" TO CLKNET "clk_c";
BLOCK PATH FROM CLKNET "clk_tmds" TO CLKNET "clk_c";

# Block Path Constraints
BLOCK PATH FROM CLKNET "auxclks[2]" TO CLKNET "clk_28m";
BLOCK PATH FROM CLKNET "auxclks[2]" TO CLKNET "clk_sys";
BLOCK PATH FROM CLKNET "auxclks[2]" TO CLKNET "clk_142m";
BLOCK PATH FROM CLKNET "clk_sys" TO CLKNET "auxclks[2]";
BLOCK PATH FROM CLKNET "clk_28m" TO CLKNET "auxclks[2]";
BLOCK PATH FROM CLKNET "clk_142m" TO CLKNET "auxclks[2]";

MULTICYCLE FROM CLKNET "clk_28m" TO CLKNET "clk_sys" 4X;
MULTICYCLE FROM CLKNET "clk_sys" TO CLKNET "clk_28m" 2X;

BLOCK PATH TO PORT "led[*]";

BLOCK PATH FROM CELL "spi_alt*";

BLOCK PATH FROM CELL "virtual_top/minimig/overclock*";
BLOCK PATH FROM CELL "virtual_top/minimig/ide_config*";
BLOCK PATH FROM CELL "virtual_top/minimig/floppy_config*";
BLOCK PATH FROM CELL "virtual_top/minimig/chipset_config*";
BLOCK PATH FROM CELL "virtual_top/minimig/memory_config*";
BLOCK PATH FROM CELL "virtual_top/minimig/cpu_config*";


BLOCK PATH FROM CELL "virtual_top/minimig/AGNUS1/bc1/beamcon0*";

BLOCK PATH TO CELL "audio_sync/*sync*";
BLOCK PATH TO CELL "clock_control/reset_sync*";
BLOCK PATH TO CELL "hdmi_inst/true_hdmi_output.packet_picker_inst/audio_sample_word_buffer*";
BLOCK PATH TO CELL "hdmi_inst/serializer/reset_x5_sync*";

BLOCK PATH TO CELL "virtual_top/gen_rtg.rtg_resetn_sync*";
BLOCK PATH TO CELL "virtual_top/gen_rtg.rtg_irq_28_sync*";
BLOCK PATH TO CELL "virtual_top/gen_rtg.rtg/*_sync*";
BLOCK PATH TO CELL "virtual_top/gen_rtg.rtg/*fifo/*_sync*";
# These held clk_sys snapshots feed only pixel logic; DMA paths stay timed.
BLOCK PATH FROM CELL "virtual_top/gen_rtg.rtg/config_sys_*";
BLOCK PATH TO CELL "virtual_top/gen_rtg.rtg/ready_vid[0]";

BLOCK PATH FROM CELL "virtual_top/gen_rtg.rtg/*fifo/rd_gray[*]" TO CELL "virtual_top/gen_rtg.rtg/*fifo/rd_gray_w1[*]";
BLOCK PATH FROM CELL "virtual_top/gen_rtg.rtg/*fifo/wr_gray[*]" TO CELL "virtual_top/gen_rtg.rtg/*fifo/wr_gray_r1[*]";

BLOCK PATH TO CELL "virtual_top/clk28_rstn_sync*";

BLOCK PATH FROM CELL "virtual_top/minimig/AGNUS1/bc1/interlace_out*" TO CELL "hdmi_inst/*";
BLOCK PATH FROM CELL "virtual_top/minimig/AGNUS1/bc1/displaypal_out*" TO CELL "hdmi_inst/*";
BLOCK PATH FROM CELL "virtual_top/minimig/AGNUS1/bc1/long_frame_r*" TO CELL "hdmi_inst/*";

BLOCK RESETPATHS ;
BLOCK ASYNCPATHS ;

MULTICYCLE FROM CELL "virtual_top/tg68k/*" TO CELL "virtual_top/sdram/*" 4X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/*" TO CELL "virtual_top/sdram/cache/*" 2X ;

MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/*" TO CELL "virtual_top/*" 4X ;
