MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/memaddr*" TO CELL "virtual_top/sdram/cache/*" 2X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/memaddr*" TO CELL "virtual_top/tg68k/pf68K_Kernel_inst/*" 4X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/addr[*]" TO CELL "virtual_top/sdram/*" 4X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/addr[*]" TO CELL "virtual_top/sdram/cache/*" 2X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/data_write*" TO CELL "virtual_top/sdram/*" 4X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/data_write*" TO CELL "virtual_top/sdram/cache/*" 2X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/long_cand*" TO CELL "virtual_top/sdram/*" 4X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/long_cand*" TO CELL "virtual_top/sdram/cache/*" 2X ;

MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/regfile*" TO CELL "virtual_top/tg68k/*" 4X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/regfile*" TO CELL "virtual_top/tg68k/data_write*" 4X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/regfile*" TO CELL "virtual_top/tg68k/pf68K_Kernel_inst/*" 4X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/regfile*" TO CELL "virtual_top/tg68k/pf68K_Kernel_inst/ALU/*" 4X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/regfile*" TO CELL "virtual_top/tg68k/pf68K_Kernel_inst/regfile*" 4X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/regfile*" TO CELL "virtual_top/sdram/*" 4X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/regfile*" TO CELL "virtual_top/sdram/cache/*" 2X ;

MULTICYCLE FROM CELL "virtual_top/tg68k/addr[*]" TO CELL "*" 3X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/addr[*]" TO CELL "virtual_top/minimig/CPU1/*" 3X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/addr[*]" TO CELL "virtual_top/sdram/*" 4X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/addr[*]" TO CELL "virtual_top/sdram/cache/*" 2X ;

MULTICYCLE FROM CELL "virtual_top/tg68k/ram_req*" TO CELL "virtual_top/tg68k/pf68K_Kernel_inst/*" 3X ;

MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/*" TO CELL "virtual_top/gen_rtg.rtg/*" 2X ;
MULTICYCLE FROM CELL "virtual_top/tg68k/pf68K_Kernel_inst/*" TO CELL "virtual_top/tg68k/u_akiko/*" 2X ;






MULTICYCLE FROM CELL "hdmi_inst/tmds_gen*.tmds_channel/*" TO CELL "hdmi_inst/serializer/g_ser*.shift*" 2X ;
BLOCK PATH TO CELL "hdmi_inst/serializer/pixel_toggle_sync[0]" ;

# HDMI package-pin data-to-forwarded-clock skew target: +/- 300 ps.
# 66 MHz pixels, 330 MHz DDR serializer clock, 660 Mb/s per data lane.
# PCB skew and serial-eye/jitter requirements need separate budgeting.
CLOCK_TO_OUT PORT "gpdi_dp[0]" MAX 0.300 ns MIN -0.300 ns CLKNET "clk_tmds" CLKOUT PORT "gpdi_dp[3]" ;
CLOCK_TO_OUT PORT "gpdi_dp[1]" MAX 0.300 ns MIN -0.300 ns CLKNET "clk_tmds" CLKOUT PORT "gpdi_dp[3]" ;
CLOCK_TO_OUT PORT "gpdi_dp[2]" MAX 0.300 ns MIN -0.300 ns CLKNET "clk_tmds" CLKOUT PORT "gpdi_dp[3]" ;

CLOCK_TO_OUT PORT "sdram_csn*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "sdram_clk" CLK_OFFSET 0.5 X ;
CLOCK_TO_OUT PORT "sdram_a*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "sdram_clk" CLK_OFFSET 0.5 X ;
CLOCK_TO_OUT PORT "sdram_dq*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "sdram_clk" CLK_OFFSET 0.5 X ;
CLOCK_TO_OUT PORT "sdram_wen*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "sdram_clk" CLK_OFFSET 0.5 X ;
CLOCK_TO_OUT PORT "sdram_rasn*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "sdram_clk" CLK_OFFSET 0.5 X ;
CLOCK_TO_OUT PORT "sdram_casn*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "sdram_clk" CLK_OFFSET 0.5 X ;
CLOCK_TO_OUT PORT "sdram_cke*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "sdram_clk" CLK_OFFSET 0.5 X ;
CLOCK_TO_OUT PORT "sdram_ba*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "sdram_clk" CLK_OFFSET 0.5 X ;
CLOCK_TO_OUT PORT "sdram_dqm*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "sdram_clk" CLK_OFFSET 0.5 X ;
LOCATE COMP "sd_dat[1]" SITE "R14";
IOBUF PORT "sd_dat[1]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "sd_dat[2]" SITE "M15";
IOBUF PORT "sd_dat[2]" IO_TYPE=LVCMOS33 PULLMODE=UP;
# Companion SPI input, MODE1; constrain for 10 MHz.
FREQUENCY PORT "gpio[24]" 10.0 MHz;

LOCATE COMP "mspi_cs" SITE "N8";
IOBUF PORT "mspi_cs" IO_TYPE=LVCMOS33 PULLMODE=UP;

LOCATE COMP "mspi_di" SITE "T8";
IOBUF PORT "mspi_di" IO_TYPE=LVCMOS33 PULLMODE=UP;

LOCATE COMP "mspi_do" SITE "T7";
IOBUF PORT "mspi_do" IO_TYPE=LVCMOS33 PULLMODE=UP;

LOCATE COMP "mspi_wp" SITE "M7";
IOBUF PORT "mspi_wp" IO_TYPE=LVCMOS33 PULLMODE=UP;

LOCATE COMP "mspi_hold" SITE "N7";
IOBUF PORT "mspi_hold" IO_TYPE=LVCMOS33 PULLMODE=UP;

LOCATE COMP "mspi_clk_ts" SITE "D12";
IOBUF PORT "mspi_clk_ts" IO_TYPE=LVCMOS33 PULLMODE=DOWN;

# MiSTle OSD/configuration exceptions. See doc/TIMING.md.
# Only the asynchronous first enable stage is exempt; the second stage stays timed.
BLOCK PATH TO CELL "osd_rtg/enable_sync[0]";
# Held menu settings, equivalent to the original osd1/sysctrl exceptions.
BLOCK PATH FROM CELL "virtual_top/minimig/USERIO1/control/screen_mode*";
BLOCK PATH FROM CELL "virtual_top/minimig/USERIO1/control/xoffset*";
BLOCK PATH FROM CELL "virtual_top/minimig/USERIO1/control/yoffset*";
BLOCK PATH FROM CELL "virtual_top/minimig/USERIO1/control/lr_filter*";
BLOCK PATH FROM CELL "virtual_top/minimig/USERIO1/control/hr_filter*";
BLOCK PATH FROM CELL "virtual_top/minimig/USERIO1/control/scanline*";
BLOCK PATH FROM CELL "companion/control/system_cpu*";
BLOCK PATH FROM CELL "companion/control/system_chipset*";
BLOCK PATH FROM CELL "companion/control/system_video*";
BLOCK PATH FROM CELL "companion/control/system_chipmem*";
BLOCK PATH FROM CELL "companion/control/system_slowmem*";
BLOCK PATH FROM CELL "companion/control/system_fastmem*";
BLOCK PATH FROM CELL "companion/control/system_turbo*";
BLOCK PATH FROM CELL "companion/control/system_volume*";
BLOCK PATH FROM CELL "companion/control/system_overclock*";

# LPF represents the DCSC output at its fastest (RTG) rate. Native pixels are
# selected only with the native 28 MHz parent; retain their real setup budget.
MAXDELAY FROM CELL "native_rgb*" TO CELL "hdmi_inst/*" 34.96 NS;
MAXDELAY FROM CELL "native_osd/*" TO CELL "hdmi_inst/*" 34.96 NS;
MAXDELAY FROM CELL "hdmi_inst/*" TO CELL "native_osd/*" 34.96 NS;
# EBR outputs are ASIC pins, not CELL endpoints in Diamond.
MAXDELAY FROM ASIC "native_osd/buffer_buffer_0_0" PIN "*" TO CELL "hdmi_inst/*" 34.96 NS;
# Native frame requests also feed the EBR read-address pins directly.
MAXDELAY FROM CELL "hdmi_inst/osd_frame_request" TO ASIC "native_osd/buffer_buffer_0_0" PIN "ADA*" 34.96 NS;

# Disk DMA length and these destinations update on the same clk7_en (1 in 4).
# NanoMig already applies this exception to the blitter. Sprite pointer RAM
# writes use that enable too; no pipeline stage or RAM latency change is needed.
MULTICYCLE FROM CELL "virtual_top/minimig/PAULA1/pf1/dsklen*" TO CELL "virtual_top/minimig/AGNUS1/bl1/*" 4X;
MULTICYCLE FROM CELL "virtual_top/minimig/PAULA1/pf1/dsklen*" TO CELL "virtual_top/minimig/AGNUS1/spr1/sprpth_ram/*" 4X;
MULTICYCLE FROM CELL "virtual_top/minimig/PAULA1/pf1/dsklen*" TO CELL "virtual_top/minimig/AGNUS1/spr1/sprptl_ram/*" 4X;

# Companion menu visibility is a held configuration bit, not bitmap data.
BLOCK PATH FROM CELL "companion/osd/enabled";

# First stages of the Companion handshakes (matching the SDC exceptions).
BLOCK PATH TO CELL "companion/rom/req_sync[0]";
BLOCK PATH TO CELL "companion/rom/ack_sync[0]";
BLOCK PATH TO CELL "companion/rom/host_reset_sync[0]";
BLOCK PATH TO CELL "companion_reset[0]";
BLOCK PATH TO CELL "companion/spi/spi_data_in_readyD[0]";
BLOCK PATH TO CELL "osd_reset_sync[0]";
BLOCK PATH TO CELL "flash_abort_sync[0]";
BLOCK PATH TO CELL "companion/boot_ready_sync[0]";

# 28 MHz SPI-flash request/result handshakes; later stages stay timed.
BLOCK PATH TO CELL "flash_reader/req_sync[0]";
BLOCK PATH TO CELL "flash_reader/ack_sync[0]";
BLOCK PATH TO CELL "flash_reader/ready_sync[0]";
BLOCK PATH TO CELL "flash_reader/reset_sync[0]";

# Bundled return data must settle within two system-clock cycles.
MAXDELAY FROM CELL "flash_reader/held_data*" TO CELL "flash_reader/dout*" 17.0 NS;
