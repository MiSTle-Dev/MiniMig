<?xml version='1.0' encoding='utf-8'?>
<config name="MiniMig MiSTle" version="0">
  <actions>
    <action name="init">
      <load file="amiga.ini" />
      <set id="R" value="1" />
    </action>
    <action name="ready">
      <set id="R" value="0" />
    </action>
    <action name="save">
      <save file="amiga.ini" />
    </action>
    <action name="reset">
      <set id="R" value="1" />
      <delay ms="10" />
      <set id="R" value="0" />
    </action>
    <action name="reset_hide">
      <link action="reset" />
      <hide />
    </action>
  </actions>
  <menu label="MiniMig MiSTle">
    <fileselector label="Floppy DF0:" ext="adf" index="0" />
    <menu label="System">
      <list label="CPU:" id="T" default="0" action="reset">
        <listentry label="68000" value="0" />
        <listentry label="68010" value="1" />
        <listentry label="68EC020" value="2" />
        <listentry label="68020" value="3" />
      </list>
      <list label="Chipset:" id="C" default="0" action="reset">
        <listentry label="OCS-A500" value="0" />
        <listentry label="OCS-A1000" value="1" />
        <listentry label="ECS" value="2" />
        <listentry label="AGA" value="3" />
      </list>
      <list label="Chipmem:" id="Y" default="1" action="reset">
        <listentry label="512kB" value="0" />
        <listentry label="1MB" value="1" />
        <listentry label="1.5MB" value="2" />
        <listentry label="2MB" value="3" />
      </list>
      <list label="Slowmem:" id="X" default="1" action="reset">
        <listentry label="None" value="0" />
        <listentry label="512kB" value="1" />
        <listentry label="1MB" value="2" />
        <listentry label="1.5MB" value="3" />
      </list>
      <list label="Fastmem:" id="Q" default="1" action="reset">
        <listentry label="None" value="0" />
        <listentry label="2MB" value="1" />
        <listentry label="4MB" value="2" />
        <listentry label="Maximum" value="3" />
      </list>
      <list label="Turbo:" id="Z" default="0">
        <listentry label="None" value="0" />
        <listentry label="Chip" value="1" />
        <listentry label="Kick" value="2" />
        <listentry label="Both" value="3" />
      </list>
      <list label="Overclock:" id="O" default="0">
        <listentry label="Disabled" value="0" />
        <listentry label="Enabled" value="1" />
      </list>
      <list label="Video:" id="V" default="0">
        <listentry label="PAL" value="0" />
        <listentry label="NTSC" value="1" />
      </list>
      <list label="Swap Joyst:" id="J" default="1">
        <listentry label="Off" value="0" />
        <listentry label="On" value="1" />
      </list>
      <image label="Kickstart" index="0" none_str="&lt;select ROM&gt;" ext="rom" default="kick.rom" action="reset_hide" />
    </menu>
    <menu label="Storage">
      <list label="Drives:" id="D" default="1">
        <listentry label="1" value="0" />
        <listentry label="2" value="1" />
        <listentry label="3" value="2" />
        <listentry label="4" value="3" />
      </list>
      <list label="Speed:" id="S" default="1">
        <listentry label="Normal" value="0" />
        <listentry label="Fast" value="1" />
      </list>
      <list label="Write:" id="P" default="1">
        <listentry label="Enabled" value="0" />
        <listentry label="Protected" value="1" />
      </list>
      <fileselector label="Floppy DF0:" ext="adf" index="0" default="df0.adf" />
      <fileselector label="Floppy DF1:" ext="adf" index="1" default="df1.adf" />
      <fileselector label="Floppy DF2:" ext="adf" index="2" default="df2.adf" />
      <fileselector label="Floppy DF3:" ext="adf" index="3" default="df3.adf" />
      <list label="IDE" id="I" default="0" action="reset">
        <listentry label="Disabled" value="0" />
        <listentry label="Enabled" value="1" />
      </list>
      <fileselector label="Harddisk DH0:" ext="hdf" index="4" default="dh0.hdf" action="reset" />
      <fileselector label="Harddisk DH1:" ext="hdf" index="5" default="dh1.hdf" action="reset" />
    </menu>
    <menu label="Settings">
      <list label="Volume:" id="A" default="2">
        <listentry label="Mute" value="0" />
        <listentry label="25%" value="1" />
        <listentry label="50%" value="2" />
        <listentry label="75%" value="3" />
        <listentry label="100%" value="4" />
      </list>
      <list label="Stereo Mix:" id="M" default="1">
        <listentry label="Disabled" value="0" />
        <listentry label="Enabled" value="1" />
      </list>
      <list label="Scanlines:" id="L" default="0">
        <listentry label="None" value="0" />
        <listentry label="Dim" value="1" />
        <listentry label="Balanced" value="2" />
      </list>
      <list label="Filter:" id="F" default="0">
        <listentry label="None" value="0" />
        <listentry label="Horizontal" value="1" />
        <listentry label="Vertical" value="2" />
        <listentry label="Hor+Ver" value="3" />
      </list>
      <list label="Screen:" id="W" default="0">
        <listentry label="Standard" value="0" />
        <listentry label="Overscan" value="1" />
        <listentry label="Wide" value="2" />
      </list>
      <range label="X Offset:" id="H" min="-128" max="127" default="-90" />
      <range label="Y Offset:" id="N" min="0" max="127" default="47" />
      <button label="Save settings" action="save" />
    </menu>
    <button label="Reset" action="reset_hide" />
  </menu>
</config>
